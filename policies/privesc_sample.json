{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LambdaEscalationVector",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "lambda:CreateFunction",
        "lambda:InvokeFunction",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PolicyModificationVector",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicyVersion"
      ],
      "Resource": "*"
    }
  ]
}
